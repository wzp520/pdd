# 复制本文件为 .env 并填写真实值
# cp .env.example .env

# ===== DeepSeek 大模型 =====
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 运行配置 =====
# 干跑模式：true 时只在日志里打印要发的回复，不真正发送（测试用）
DRY_RUN=true
# 轮询新消息的间隔：随机范围（秒），模拟人工节奏、避免被识别为自动化
POLL_MIN=3
POLL_MAX=8
# 人工最近一次回复后，再无人工回复超过这个时长（分钟），AI 才恢复接管该会话
HUMAN_PAUSE_MINUTES=10
# 浏览器是否无头运行：开发/登录时用 false（看得到界面），服务器部署可 true
HEADLESS=false

# ===== 飞书通知（转人工时推送到群）=====
FEISHU_ENABLED=false
# 群自定义机器人 Webhook 地址
FEISHU_WEBHOOK=
# 签名密钥（机器人开了"加签"才填）
FEISHU_SECRET=
# @的人 open_id，逗号分隔；填 all 为@所有人
FEISHU_AT_USERS=
